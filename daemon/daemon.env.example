# life-log 데몬 환경변수 (VM: ~/.config/life-log/daemon.env 로 복사 후 실제 값 입력)
# chmod 600 로 권한 제한할 것.

# life-log repo (command/status/data 저장소)
GITHUB_REPO=Jacob-9909/life-log
GITHUB_BRANCH=main

# contents 읽기/쓰기 + repo 커밋 조회 권한이 있는 토큰 (classic PAT: repo 스코프 / fine-grained: Contents RW + 대상 repo)
GITHUB_TOKEN=__PUT_TOKEN_HERE__

# 커밋을 수집할 계정. 비우면 토큰 소유자(/user/repos, private 포함)
GITHUB_OWNER=Jacob-9909

# 커밋 저자 이메일 필터 (쉼표 구분)
AUTHOR_EMAILS=whjeong@didim365.com,cj0336j@gmail.com

# NVIDIA NIM 요약 (없으면 템플릿 폴백)
NVIDIA_API_KEY=__PUT_NVIDIA_KEY_HERE__
NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# job repo clone 경로 (VM)
JOB_DIR=/home/ubuntu/job

# 폴링 주기 (ms)
POLL_MS=15000
